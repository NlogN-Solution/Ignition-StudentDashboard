# REACT_APP_API_URL=https://ignition-backend-2ste.onrender.com/api/v1
REACT_APP_API_URL=http://localhost:8001/api/v1

# The dev server's port. Pinned rather than left to CRA's default: a plain
# `next dev` gives the public site (Ignition-Landing) :3000, so CRA finds it
# taken and offers whatever is free — while every link into the portal from
# over there (Apply, Login, Dashboard) is an absolute URL built from
# NEXT_PUBLIC_PORTAL_URL, which is fixed at build time. :3001 is that value on
# both sides; it is also in the backend's CORS_ORIGINS.
PORT=3001
